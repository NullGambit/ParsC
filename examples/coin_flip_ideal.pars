import std.io
import std.random

enum Result
{
    Heads
    Tails
    Invalid
}

impl Result 
{
    fn print_result(answer: Result)
    {
        match self 
        {
            answer == self => println("You win!")
            answer != self => println("You lose!")
            Invalid => println("Invalid input, try again!")
        }
    }
}

fn main()
{
    loop
    {
        println("heads or tails (h | t | q): ")

        var input = get_term_input()

        // explicit typing forces a coercion 
        var correct: Result = rand_range(0, 1)

        var answer: i32

        var result = match input 
        {
            'h' => Heads
            't' => Tails
            _ => Invalid
        }

        result.print_result(answer)
    }
}
