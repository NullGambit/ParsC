import core.stdc.stdio

// can use any identifier to name the elements
alias Vec3 = [3]i32{x, y, z, w}

fn print_vec(vec: Vec3) => printf("%d, %d, %d\n", vec.x, vec.y, vec.z)

fn main()
{
    // the type here can be omitted because Vec3 is not a distinct alias
    // and so when passed to print_vec it will be turned into an array that has those members and thus
    // will work perfectly within the function but here we can still add the type to get the named initialization like structs
    var position: Vec3 = [x: 1, y: 2, z: 3]

    var w = position.w

    print_vec(position)
}