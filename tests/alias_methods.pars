import core.stdc.stdio

alias Integer = i32

struct User
{
    value: i32
}

impl User
{
    fn get_value() => self.value
}

alias U = User

impl Integer
{
    fn print() => printf("%d\n", ^self)
}

fn main()
{
    let user: U = {10}

    var value = user.get_value()

    let integer: Integer = 10

    integer.print()
}