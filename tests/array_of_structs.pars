import core.stdc.stdio

struct Test
{
    a: i32
}

fn print_tests(tests: []Test)
{
    for test in tests
    {
        printf("%d\n", test.a)
    }
}

fn main()
{
    var tests1 = [Test{1}, {2}, {3}]
    var tests2: []Test = [{1}, {2}, {3}]
    var tests3: [?]Test = [{1}, {2}, {3}]

    print_tests(tests1)
    print_tests(tests2)
    print_tests(tests3)
}

