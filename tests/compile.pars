@[extern, private]
fn printf(fmt: str, ptr: ^i32, n: i32): i32

@[extern, private]
fn puts(s: str): i32

@extern
fn malloc(size: i32): ^void

@extern
fn free(ptr: ^void)

fn print_ptr(p: ^i32) => printf("address = %p\nvalue = %d\n", p, ^p)

fn test2()
{
    var value = 10

    // void pointers are any pointers
    var vptr: *void

    vptr = &value

    print_ptr(&value)
}

fn test1()
{
    var x = 10

    var ptr = &x

    ^ptr += 20

    if ptr != nil
    {
        print_ptr(ptr)
    }

    var ptr2: ^i32

    ptr2 = &x

    if ptr == ptr2
    {
        puts("pointers match")
    }
}

fn main()
{
    var ptr = cast(^i32)malloc(sizeof(i32) * 2)

    ^ptr = 10

    print_ptr(ptr)

    ptr += 1

    ^ptr = 20

    print_ptr(ptr)

    ptr -= 1

    print_ptr(ptr)

    free(ptr)
}


