import core.stdc.stdio

struct Base
{
    name: str
    score: i32
}

struct Derived
{
    super: Base
}

fn print_base(base: ^Base)
{
    printf("%s %d\n", base.name, base.score)
}

fn main()
{
    var derived: Derived

    derived.super.name = "john"
    derived.super.score = 100

    print_base(&derived)
}
