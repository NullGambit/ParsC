fn test5()
{
    var x = 10

    var ptr = &x

    ^ptr += 20

    if ptr != nil
    {
        print_ptr(ptr)
    }

    var ptr2: ^i32

    ptr2 = &x

    if ptr == ptr2
    {
        puts("pointers match")
    }
}

@extern
fn malloc(size: i32): ^void

@extern
fn free(ptr: ^void)

fn main()
{
    var ptr = cast(^i32)malloc(sizeof(i32))

    ^ptr = 10

    print_ptr(ptr)

    free(ptr)
}


