
extern fn printf(s: str, n: i32): i32
extern fn puts(value: str): i32
extern fn malloc(size: i32): i32

fn main()
{
    var fmt = "hello world %d\n"

    var x = add(sizeof(i32), 20)
    printf(fmt, x)

    var ptr = malloc(sizeof(i32))

    printf("ptr %p\n", ptr)
}

fn do_nothing()
{
    
}

fn do_nothing2() => do_nothing()

fn add(a: i32, b: i32) => a + b
