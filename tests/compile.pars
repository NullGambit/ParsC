// built in c interop
import core.stdc.stdio
import core.stdc.stdlib

// TODOS
// automatic coercing for types 32 to u64 good. 64 to 32 not good
// automatic va_list creation when passing ... to another function
// manual va_list support
// possibly transform functions to know the size of va_list
// add additional module path lookups
// correct constness
// constness comes within types. even aliases

// | | abs operator and ** power operator
fn do_math(x: i32) => | 1 - 2 ** -x |

fn main()
{
    var limit = 10
    
    for i in 0..limit
    {
        printf("#%d\n", i)
    }

    if limit > 5
    {
        printf("%d is bigger than 5\n", limit)
    }
    else
    {
        printf("%d is smaller than 5\n", limit)
    }

    var y = do_math(32)

    printf("math result = %d\n", y)
    
    // unrestricted memory access
    var ptr = cast(^i32)malloc(sizeof(i32))
     
    if ptr == nil 
    {
        printf("pointer is nil\n")
        return
    }
    
    ^ptr = 10
    
    printf("%d %p\n", ^ptr, ptr)
}