import core.stdc.stdio

struct Nested 
{
    value: i32
}

struct Data 
{
    array: [6]Nested
}


fn main()
{
    let data = Data{}

    for element, i in data.array 
    {
        if element.value == 0 
        {
            data.array[i] = Nested{100}

            printf("%d\n", i)
        }
    }

    printf("%d\n", data.array[0].value)
}