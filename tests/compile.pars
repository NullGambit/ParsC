import core.stdc.stdio
import lib = core.stdc.stdlib

struct Base
{
    name: str
    score: i32
}

struct Derived
{
    super: Base
}

fn print_base(base: ^Base)
{
    var name = base.name
    printf("%s %d\n", base.name, base.score)
}

fn main()
{
    var ptr = cast(^i32)lib.malloc(4)

    var array = [1, 2, 3]

    array.ptr = nil

    var derived: Derived

    derived.super.name = "john"
    derived.super.score = 100

    //var n = derived.super.name
    //var s = derived.super.score

    //printf("%s %d\n", n, s)
    //printf("%s %d\n", derived.super.name, derived.super.score)

    print_base(cast(^Base)&derived)
}
