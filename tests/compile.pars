import core.stdc.stdio

fn add(a: i32, b: i32) => a + b
fn sub(a: i32, b: i32) => a - b
fn mul(a: i32, b: i32) => a * b
fn div(a: i32, b: i32) => a / b

fn test(a: i32, b: i32): i32
{
    return 0
}

alias OpFn = fn(i32, i32): i32

fn main()
{
    var op: OpFn

