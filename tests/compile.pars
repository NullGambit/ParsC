@[extern, private]
fn printf(fmt: str): i32

fn is_greater(a: i32, b: i32) => a > b

fn main()
{
    const print_yes = true

    $if print_yes
    {
        printf("yes\n")
    }
    else
    {
        printf("no\n")
    }

    $if is_greater(10, 2)
    {
        printf("10 is greater than 2\n")
    }

    printf("the end\n")
}


