import core.stdc.stdio

fn print_array(arr: []i32)
{
    printf("printing array of size %d\n", arr.length)

    for i in 0..arr.length
    {
        printf("%d\n", arr[i])
    }
}

fn main()
{
    var my_array = [1, 2, 3, 4, 5]

    var slice: []i32

    slice = my_array[1:3]

    print_array(slice)
    print_array(my_array[1:])
    print_array(my_array)
}

