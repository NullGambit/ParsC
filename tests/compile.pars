import core.stdc.stdio

struct User
{
    name: str
    score: i32
    is_valid: bool
}

fn print_user(user: User) => printf("name: %s, score: %d, is_valid: %d\n", user.name, user.score, user.is_valid)

fn main()
{
    var user: User = {score: 50, name: "henry"}
    //var user = User{"henry", score: 50}
    //var user = User{score: 50, "henry"} // this one should error out
    //var user = User{name: "henry", score: 50}
    //var user = User{"henry", score: 50, true}
    //var user = User{score: 50, true}
    //var user = User{score: 50}

    //user.name = "empty"

    print_user(user)
    print_user({name: "john", score: 5, is_valid: false})
}

