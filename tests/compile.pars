import core.stdc.stdio

fn print(value: i32)
{
    printf("%d\n", value)
}

fn print(value: str)
{
    printf("%s\n", value)
}

fn print(value: bool)
{
    var s: str

    if value
    {
        s = "true"
    }
    else
    {
        s = "false"
    }

    printf("%s\n", s)
}

fn main()
{
    print(10)
    print("hello")
    print(false)
}