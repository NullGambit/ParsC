// pointer arithmetic

fn test2()
{
    var value = 10

    var vptr: *void

    vptr = &value

    print_ptr(&value)
}

fn test3()
{
    var value = 10

    var *ptr1 = &value
    var *ptr2 = &value

    if ptr1 == ptr2
    {
        puts("pointers are equal")
    }

    puts("==== Information ====")
    print_ptr(ptr1)
}

fn test4()
{
    var value = 10
    var ptr: *i32

    ptr = &value
    ptr = nil

    if ptr == nil
    {
        puts("pointer is nil")
    }
    else
    {
        print_ptr(ptr)
    }
}

fn main()
{
    test4()
}


