import core.stdc.stdio

fn main()
{
    // can be explicitly typed like this
    // var mat: [4][4]i32

    var mat =
    [
        [1, 22, 3, 47],
        [51, 60, 7, 8],
        [32, 5, 12, 8],
        [0, 9, 12, 31]
    ]

    for n in mat
    {
        for k, i in n
        {
            printf("%d", k)

            if i < n.length
            {
                printf(",")
            }
        }

        printf("\n")
    }
}