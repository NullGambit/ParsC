@[extern, private]
fn printf(fmt: str, n1: i32): i32

fn main()
{
    var x = 6

    if x >= 5
    {
        printf("%d is greater than 5\n", x)
    }
    else if x <= 10
    {
        printf("%d is less than 10\n", x)
        x = 20
    }

    printf("you've reached the end with value = %d\n", x)
}


